/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/voice/*
  Cache-Control: public, max-age=31536000, immutable
/nel/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/ground.png
  Cache-Control: public, max-age=86400
/faq-full.json
  Cache-Control: public, max-age=3600
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=86400
